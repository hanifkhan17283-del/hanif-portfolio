# Server-side PostgreSQL connection string. Use a persistent managed database in production.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/portfolio
# Set true when your database provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# SMTP account for a verified sender on your email provider.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
CONTACT_RECIPIENT=hanifkhan17283@gmail.com

# Generate a unique random value, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Enable only when the app is behind a trusted single reverse proxy.
TRUST_PROXY=false

# Existing public portfolio data settings (not secrets unless you use a GitHub token).
GITHUB_USERNAME=hanifkhan17283-del
USE_GITHUB_DATA=true
MEDIUM_USERNAME=
# Optional public CRA token if this project needs one. CRA variables are visible in browser code.
REACT_APP_GITHUB_TOKEN=
